{
  "name": "routerfarm-dashboard",
  "version": "2.0.0",
  "private": true,
  "author": "IRONMAN <evergreentechnology.wy@gmail.com>",
  "description": "Native Windows dashboard for router-controlled Android farm operations",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "start:desktop": "electron .",
    "test:unit": "node --test ./test/*.test.js",
    "test:router-connect": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-connect-phone-to-router.ps1",
    "test:device-wifi": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-set-device-wifi-state.ps1",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-routerfarm-smoke.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "npm audit",
    "dist:desktop": "electron-builder --win portable nsis --x64 --config.win.signAndEditExecutable=false"
  },
  "build": {
    "appId": "com.routerfarm.desktop",
    "productName": "RouterFarm",
    "artifactName": "${productName} ${version}.${ext}",
    "asar": false,
    "files": [
      "assets/**/*",
      "electron/**/*",
      "web/**/*",
      "scripts/**/*",
      "android/**/*",
      "config/**/*",
      "server.js",
      "package.json",
      "README.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/routerfarm.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "assets/routerfarm.ico",
      "uninstallerIcon": "assets/routerfarm.ico",
      "installerHeaderIcon": "assets/routerfarm.ico",
      "shortcutName": "RouterFarm",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^37.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^10.2.1",
    "globals": "^17.5.0"
  }
}
